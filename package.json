{
  "name": "tiptoi-manager",
  "version": "0.2.0",
  "description": "A software to manage tiptoi audio files",
  "repository": {
    "type": "git",
    "url": "git@github.com:nico-martin/tiptoi-manager.git"
  },
  "author": "Nico Martin - https://nico.dev",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "serve-php": "php -S localhost:8000 -t api",
    "generate-pwa-assets": "npx --yes @vite-pwa/assets-generator"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "cookies-ts": "^1.0.5",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^10.1.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss-mixins": "^12.1.2",
    "postcss-nesting": "^14.0.1",
    "postcss-preset-env": "^11.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-html-config": "^2.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-svgr": "^5.2.0"
  },
  "browserslist": [
    "> 1%"
  ],
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "singleQuote": true,
    "trailingComma": "es5",
    "importOrder": [
      "^\\./styles\\.css$",
      "<THIRD_PARTY_MODULES>",
      "^@theme/(.*)$",
      "^@app/(.*)$",
      "^@utils/(.*)$",
      "^@store/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true
  },
  "type": "module"
}
